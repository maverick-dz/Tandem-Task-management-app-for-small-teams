# Neon: copy the two connection strings from the Neon dashboard (Connect).
# Use the +asyncpg driver prefix and do NOT keep ?sslmode=require in the URL
# (asyncpg gets ssl through connect_args in app/db/session.py).

# Pooled URL (host contains -pooler): used by the app.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb
# Direct URL (no -pooler): used by Alembic migrations.
DATABASE_URL_DIRECT=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# true on exactly ONE instance (it sends reminders)
RUN_SCHEDULER=false

# Firebase Cloud Messaging service-account JSON. Leave empty to disable push:
# the Alerts list still works.
FIREBASE_CREDENTIALS_PATH=
